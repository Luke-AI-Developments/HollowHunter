<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground-only GPS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Health Connect: read-only, foreground-only for this spike. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Required for Health Connect's availability check (PackageManager
         query visibility) on API 30+. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- Registers this plugin with Godot's v2 Android plugin runtime
             registry. Without this, Engine.has_singleton() never finds it. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.GpsHealthBridge"
            android:value="com.hollowhunter.gpshealthbridge.GpsHealthBridgePlugin" />
    </application>

</manifest>
